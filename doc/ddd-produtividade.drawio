        <mxCell id="9io1BMaQ7AhXAmXuntyE-9" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;table data-start=&quot;9742&quot; data-end=&quot;10035&quot; class=&quot;w-fit min-w-(--thread-content-width)&quot;&gt;&lt;thead data-start=&quot;9742&quot; data-end=&quot;9767&quot;&gt;&lt;tr data-start=&quot;9742&quot; data-end=&quot;9767&quot;&gt;&lt;th data-start=&quot;9742&quot; data-end=&quot;9753&quot; data-col-size=&quot;sm&quot; class=&quot;last:pe-10&quot;&gt;Pergunta&lt;/th&gt;&lt;th data-start=&quot;9753&quot; data-end=&quot;9767&quot; data-col-size=&quot;sm&quot; class=&quot;last:pe-10&quot;&gt;&amp;nbsp;|&amp;nbsp; Capacidade&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody data-start=&quot;9778&quot; data-end=&quot;10035&quot;&gt;&lt;tr data-start=&quot;9778&quot; data-end=&quot;9838&quot;&gt;&lt;td data-start=&quot;9778&quot; data-end=&quot;9802&quot; data-col-size=&quot;sm&quot;&gt;Onde existe produção?&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;9802&quot; data-end=&quot;9838&quot;&gt;&amp;nbsp;|&amp;nbsp; Delimitação de áreas cultiváveis&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;9839&quot; data-end=&quot;9897&quot;&gt;&lt;td data-start=&quot;9839&quot; data-end=&quot;9869&quot; data-col-size=&quot;sm&quot;&gt;O que está sendo produzido?&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;9869&quot; data-end=&quot;9897&quot;&gt;&amp;nbsp;|&amp;nbsp;&amp;nbsp;Identificação da cultura&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;9898&quot; data-end=&quot;9960&quot;&gt;&lt;td data-start=&quot;9898&quot; data-end=&quot;9934&quot; data-col-size=&quot;sm&quot;&gt;Quando ocorreu o ciclo produtivo?&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;9934&quot; data-end=&quot;9960&quot;&gt;&amp;nbsp;|&amp;nbsp;&amp;nbsp;Monitoramento da safra&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;9961&quot; data-end=&quot;10035&quot;&gt;&lt;td data-start=&quot;9961&quot; data-end=&quot;9993&quot; data-col-size=&quot;sm&quot;&g