        <mxCell id="9io1BMaQ7AhXAmXuntyE-31" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 data-section-id=&quot;1od8lse&quot; data-start=&quot;908&quot; data-end=&quot;950&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;Contexto de Produtividade Agropecuária&lt;/h3&gt;&lt;p data-start=&quot;952&quot; data-end=&quot;1027&quot;&gt;É responsável por produzir e explicar as informações geradas pelos modelos:&lt;/p&gt;&lt;ul data-start=&quot;1029&quot; data-end=&quot;1331&quot;&gt;&lt;li data-section-id=&quot;1rvf4k1&quot; data-start=&quot;1029&quot; data-end=&quot;1064&quot;&gt;delimitação de áreas cultiváveis;&lt;/li&gt;&lt;li data-section-id=&quot;1rxz3pw&quot; data-start=&quot;1065&quot; data-end=&quot;1093&quot;&gt;identificação de culturas;&lt;/li&gt;&lt;li data-section-id=&quot;1e4ruxm&quot; data-start=&quot;1094&quot; data-end=&quot;1132&quot;&gt;identificação de plantio e colheita;&lt;/li&gt;&lt;li data-section-id=&quot;11yckex&quot; data-start=&quot;1133&quot; data-end=&quot;1159&quot;&gt;caracterização da safra;&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;17sl6rp&quot; data-start=&quot;1160&quot; data-end=&quot;1190&quot;&gt;estimativa de produtividade;&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;1ei93jc&quot; data-start=&quot;1191&quot; data-end=&quot;1216&quot;&gt;estimativa de produção;&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;1cttlqi&quot; data-start=&quot;1217&quot; data-end=&quot;1238&quot;&gt;nível de confiança;&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;rx3pxi&quot; data-start=&quot;1239&quot; data-end=&quot;1258&quot;&gt;versão do modelo;&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;jlk1n8&quot; data-start=&quot;1259&quot; data-end=&quot;1290&quot;&gt;data e período da inferência;&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;g0y7ts&quot; data-start=&quot;1291&quot; data-end=&quot;1331&quot;&gt;revisão ou cancelamento de resultados.&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;1333&quot; data-end=&quot;1378&quot;&gt;Ele possui a autoridade sobre perguntas como:&lt;/p&gt;&lt;ul data-start=&quot;1380&quot; data-end=&quot;1635&quot;&gt;&lt;li data-section-id=&quot;188ysgu&quot; data-start=&quot;1380&quot; data-end=&quot;1416&quot;&gt;Qual modelo produziu a informação?&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;1hxdnub&quot; data-start=&quot;1417&quot; data-end=&quot;1445&quot;&gt;Qual versão foi utilizada?&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;1jzas9c&quot; data-start=&quot;1446&quot; data-end=&quot;1479&quot;&gt;Quais dados foram considerados?&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;vuucog&quot; data-start=&quot;1480&quot; data-end=&quot;1513&quot;&gt;Qual é a confiança da previsão?&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;uc0kus&quot; data-start=&quot;1514&quot; data-end=&quot;1566&quot;&gt;A estimativa foi substituída por uma mais recente?&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;1k7cerw&quot; data-start=&quot;1567&quot; data-end=&quot;1635&quot;&gt;A informação representa uma observação, classificação ou previsão?&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="360" width="440" x="560" y="2240" as="geometry" />
        </mxCell>
        <mxCell id="9io1BMaQ7AhXAmXuntyE-32" parent="1" style="text;whiteSpace=wrap;html=1;spacingLeft=3;" value="&lt;h3 data-section-id=&quot;1hw5vhs&quot; data-start=&quot;1716&quot; data-end=&quot;1736&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;Contexto do Birô&lt;/h3&gt;&lt;p data-start=&quot;1738&quot; data-end=&quot;1820&quot;&gt;É responsável por transformar informações heterogêneas em uma visão institucional:&lt;/p&gt;&lt;ul data-start=&quot;1822&quot; data-end=&quot;2288&quot;&gt;&lt;br&gt;&lt;li data-section-id=&quot;1r9ixz8&quot; data-start=&quot;1822&quot; data-end=&quot;1865&quot;&gt;identificar a propriedade correspondente;&lt;/li&gt;&lt;li data-section-id=&quot;1lxka01&quot; data-start=&quot;1866&quot; data-end=&quot;1914&quot;&gt;relacionar informações a uma geometria válida;&lt;/li&gt;&lt;li data-section-id=&quot;arvgky&quot; data-start=&quot;1915&quot; data-end=&quot;1958&quot;&gt;receber informações de diferentes fontes;&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;11cwicg&quot; data-start=&quot;1959&quot; data-end=&quot;2000&quot;&gt;validar contratos e requisitos mínimos;&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;1la9t9t&quot; data-start=&quot;2001&quot; data-end=&quot;2026&quot;&gt;controlar proveniência;&lt;/li&gt;&lt;li data-section-id=&quot;1rpoejr&quot; data-start=&quot;2027&quot; data-end=&quot;2064&quot;&gt;resolver ou registrar divergências;&lt;/li&gt;&lt;li data-section-id=&quot;pg5w33&quot; data-start=&quot;2065&quot; data-end=&quot;2100&quot;&gt;definir precedência entre fontes;&lt;/li&gt;&lt;li data-section-id=&quot;1n7pl00&quot; data-start=&quot;2101&quot; data-end=&quot;2122&quot;&gt;controlar vigência;&lt;/li&gt;&lt;li data-section-id=&quot;a3ixki&quot; data-start=&quot;2123&quot; data-end=&quot;2148&quot;&gt;consolidar o histórico;&lt;/li&gt;&lt;li data-section-id=&quot;1km18t8&quot; data-start=&quot;2149&quot; data-end=&quot;2190&quot;&gt;definir qual informação está publicada;&lt;/li&gt;&lt;li data-section-id=&quot;17xz3w1&quot; data-start=&quot;2191&quot; data-end=&quot;2245&quot;&gt;disponibilizar consultas transacionais e analíticas;&lt;/li&gt;&lt;li data-section-id=&quot;tt4bh6&quot; data-start=&quot;2246&quot; data-end=&quot;2288&quot;&gt;aplicar regras de acesso e distribuição.&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;2290&quot; data-end=&quot;2326&quot;&gt;Ele responde a perguntas diferentes:&lt;/p&gt;&lt;ul data-start=&quot;2328&quot; data-end=&quot;2668&quot;&gt;&lt;li data-section-id=&quot;6coqqg&quot; data-start=&quot;2328&quot; data-end=&quot;2382&quot;&gt;Qual é a visão institucional vigente da propriedade?&lt;/li&gt;&lt;li data-section-id=&quot;qdf2dc&quot; data-start=&quot;2383&quot; data-end=&quot;2420&quot;&gt;De qual fonte veio cada informação?&lt;/li&gt;&lt;li data-section-id=&quot;1en6r3u&quot; data-start=&quot;2421&quot; data-end=&quot;2455&quot;&gt;Existem informações divergentes?&lt;/li&gt;&lt;li data-section-id=&quot;lbg581&quot; data-start=&quot;2456&quot; data-end=&quot;2495&quot;&gt;Qual informação pode ser distribuída?&lt;/li&gt;&lt;li data-section-id=&quot;1dei05v&quot; data-start=&quot;2496&quot; data-end=&quot;2549&quot;&gt;Qual era a visão institucional em determinada data?&lt;/li&gt;&lt;li data-section-id=&quot;1bcl6ps&quot; data-start=&quot;2550&quot; data-end=&quot;2616&quot;&gt;Essa informação é observada, declarada, estimada ou consolidada?&lt;/li&gt;&lt;li data-section-id=&quot;1vo0uo1&quot; data-start=&quot;2617&quot; data-end=&quot;2668&quot;&gt;Qual fonte possui precedência para esse atributo?&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="420" width="480" x="1120" y="2240" as="geometry" />
        </mxCell>
        <mxCell id="9io1BMaQ7AhXAmXuntyE-33" parent="1" style="text;whiteSpace=wrap;html=1;spacingLeft=3;" value="&lt;h2 data-section-id=&quot;jdqi3y&quot; data-start=&quot;4202&quot; data-end=&quot;4263&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;O modelo do Birô não deve copiar o modelo de Produtividade&lt;span aria-hidden=&quot;true&quot; class=&quot;PDq2pG_selectionAnchor&quot;&gt;&lt;/span&gt;&lt;/h2&gt;&lt;p data-start=&quot;4265&quot; data-end=&quot;4311&quot;&gt;Produtividade pode possuir uma estrutura como:&lt;/p&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;4313&quot; data-end=&quot;4480&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼs ͼ16&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;EstimativaDeProdutividade&lt;br&gt;├── area_cultivada&lt;br&gt;├── safra&lt;br&gt;├── cultura&lt;br&gt;├── sacas_por_hectare&lt;br&gt;├── producao_estimada&lt;br&gt;├── confianca&lt;br&gt;├── modelo&lt;br&gt;└── data_inferencia&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;p data-start=&quot;4482&quot; data-end=&quot;4537&quot;&gt;O Birô pode traduzir isso para um modelo mais genérico:&lt;/p&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;4539&quot; data-end=&quot;4739&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼs ͼ16&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;InformacaoDaPropriedade&lt;br&gt;├── propriedade&lt;br&gt;├── categoria&lt;br&gt;├── valor&lt;br&gt;├── período_referencia&lt;br&gt;├── fonte&lt;br&gt;├── método_de_obtencao&lt;br&gt;├── confiança&lt;br&gt;├── vigência&lt;br&gt;├── status_de_consolidacao&lt;br&gt;└── evidências&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;" vertex="1">
