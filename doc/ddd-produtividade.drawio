        <mxCell id="9io1BMaQ7AhXAmXuntyE-2" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;table data-start=&quot;2833&quot; data-end=&quot;3147&quot; class=&quot;w-fit min-w-(--thread-content-width)&quot;&gt;&lt;thead data-start=&quot;2833&quot; data-end=&quot;2885&quot;&gt;&lt;tr data-start=&quot;2833&quot; data-end=&quot;2885&quot;&gt;&lt;th data-start=&quot;2833&quot; data-end=&quot;2857&quot; data-col-size=&quot;sm&quot; class=&quot;last:pe-10&quot;&gt;Capacidade de negócio&lt;/th&gt;&lt;th data-start=&quot;2857&quot; data-end=&quot;2885&quot; data-col-size=&quot;sm&quot; class=&quot;last:pe-10&quot;&gt;&amp;nbsp; |&amp;nbsp; Solução técnica possível&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody data-start=&quot;2896&quot; data-end=&quot;3147&quot;&gt;&lt;tr data-start=&quot;2896&quot; data-end=&quot;2939&quot;&gt;&lt;td data-start=&quot;2896&quot; data-end=&quot;2923&quot; data-col-size=&quot;sm&quot;&gt;Determinar o uso do solo&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;2923&quot; data-end=&quot;2939&quot;&gt;&amp;nbsp; |&amp;nbsp; Modelo de ML&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;2940&quot; data-end=&quot;2995&quot;&gt;&lt;td data-start=&quot;2940&quot; data-end=&quot;2971&quot; data-col-size=&quot;sm&quot;&gt;Receber informações externas&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;2971&quot; data-end=&quot;2995&quot;&gt;&amp;nbsp; |&amp;nbsp; Pipeline de ingestão&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;2996&quot; data-end=&quot;3036&quot;&gt;&lt;td data-start=&quot;2996&quot; data-end=&quot;3029&quot; data-col-size=&quot;sm&quot;&gt;Consultar situação territorial&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;3029&quot; data-end=&quot;3036&quot;&gt;&amp;nbsp; |&amp;nbsp; API&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;3037&quot; data-end=&quot;3100&quot;&gt;&lt;td data-start=&quot;3037&quot; data-end=&quot;3068&quot; data-col-size=&quot;sm&quot;&gt;Manter histórico territorial&l