        <mxCell id="fM1tTdFUm4pOwlo0JNWG-49" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;li data-section-id=&quot;1apqp2m&quot; data-start=&quot;603&quot; data-end=&quot;664&quot;&gt;&lt;strong data-start=&quot;605&quot; data-end=&quot;616&quot;&gt;Domínio&lt;/strong&gt;: área ampla do negócio que está sendo estudada.&lt;/li&gt;&lt;li data-section-id=&quot;1kebsou&quot; data-start=&quot;665&quot; data-end=&quot;709&quot;&gt;&lt;strong data-start=&quot;667&quot; data-end=&quot;682&quot;&gt;Subdomínios&lt;/strong&gt;: decomposições dessa área.&lt;/li&gt;&lt;li data-section-id=&quot;soo3v5&quot; data-start=&quot;710&quot; data-end=&quot;788&quot;&gt;&lt;strong data-start=&quot;712&quot; data-end=&quot;736&quot;&gt;Subdomínio principal&lt;/strong&gt;: o subdomínio que produz diferenciação estratégica.&lt;/li&gt;" vertex="1">
