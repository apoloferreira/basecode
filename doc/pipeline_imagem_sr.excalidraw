      "boundElements": [],
      "updated": 1785080784698,
      "link": null,
      "locked": false,
      "text": "Periodicidade que o sensor revisita o mesmo alvo, por exemplo a cada 16 dias.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Periodicidade que o sensor revisita o mesmo alvo, por exemplo a cada 16 dias.",
