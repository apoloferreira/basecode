      "seed": 1497513295,
      "version": 756,
      "versionNonce": 983241665,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785080784698,
      "link": null,
      "locked": false,
      "text": "Número e tamanho das regiões espectrais (bandas), \npor exemplo: vermelho, verde, azul, infravermelho próximo, etc. ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Número e tamanho das regiões espectrais (bandas), \npor exemplo: vermelho, verde, azul, infravermelho próximo, etc. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kctaxuLWKujL2aIffgiPa",
      "type": "text",
      "x": 11018.926978449785,
