    {
      "id": "5TdbzCzf_4vMc9Fiso-Sl",
      "type": "text",
      "x": 6755.355504492209,
      "y": 3206.9766967842015,
      "width": 506.25,
      "height": 43.199999999999996,
      "angle": 0,
      "strokeColor": "#1971c2",
