      "type": "text",
      "x": 1543.1781625560075,
      "y": 2424.3381955419886,
      "width": 1202.2687717013873,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
