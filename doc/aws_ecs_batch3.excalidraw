      "index": "bNQ",
      "roundness": null,
      "seed": 1966052487,
      "version": 732,
      "versionNonce": 525366879,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785715119539,
      "link": null,
      "locked": false,
      "text": "- Onde os jobs ficam esperando execução\n- Pode ter prioridade\n- Pode apontar para múltiplos compute environments\n\n*truque: fila que tenta Spot primeiro e cai para On-Demand se não houver capacidade.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Onde os jobs ficam esperando execução\n- Pode ter prioridade\n- Pode apontar para múltiplos compute environments\n\n*truque: fila que tenta Spot primeiro e cai para On-Demand se não houver capacidade.",
      "autoResize": false,
      "lineHeight": 1.25
    },
