      "index": "baZ",
      "roundness": null,
      "seed": 1543848989,
      "version": 1061,
      "versionNonce": 1930821843,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784414837051,
      "link": null,
      "locked": false,
      "text": "A menor unidade. Descreve um container: imagem no ECR, portas, variáveis de ambiente, limites de CPU/memória, log driver,\nhealth check, pontos de montagem. Não existe sozinha — vive dentro de uma Task Definition.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A menor unidade. Descreve um container: imagem no ECR, portas, variáveis de ambiente, limites de CPU/memória, log driver, health check, pontos de montagem. Não existe sozinha — vive dentro de uma Task Definition.",
      "autoResize": false,
      "lineHeight": 1.25
    },
