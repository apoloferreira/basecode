      "seed": 1601698365,
      "version": 1141,
      "versionNonce": 1668141235,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784414837051,
      "link": null,
      "locked": false,
      "text": "Uma instância em execução de uma Task Definition. É efêmera — roda até terminar ou ser parada. Se a Task Definition tem 2 containers,\na Task sobe os 2 lado a lado, compartilhando rede e volumes. Você pode rodar uma Task avulsa (RunTask) para um job pontual.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Uma instância em execução de uma Task Definition. É efêmera — roda até terminar ou ser parada. Se a Task Definition tem 2 containers, a Task sobe os 2 lado a lado, compartilhando rede e volumes. Você pode rodar uma Task avulsa (RunTask) para um job pontual.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "t1II08i-bT-M9svu5dcen",
      "type": "text",
      "x": -4193.000690794683,
      "y": 2945.363601546108,
      "width": 129.92051696777344,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
