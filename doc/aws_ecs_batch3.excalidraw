    {
      "id": "2TEVZ8O4_si7tG8V8zl_a",
      "type": "text",
      "x": 1640.6032350132482,
      "y": 838.0951460039064,
      "width": 1118.96914115595,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
