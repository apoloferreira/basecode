    {
      "id": "r-CmVQnBpo6gqQIJUDY4x",
      "type": "text",
      "x": 1543.1781625560075,
      "y": 2755.576290780083,
      "width": 580.850830078125,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNT",
      "roundness": null,
      "seed": 878837959,
      "version": 711,
      "versionNonce": 4172447,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785715119539,
      "link": null,
      "locked": false,
      "text": "O template do job.\nDefine:\n    - imagem ECR\n    -  comando\n    - vCPU/memória/GPU\n    - IAM role do container \n    - variáveis de ambiente\n    - volumes/EFS\n    - retryStrategy\n    - timeout",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O template do job.\nDefine:\n    - imagem ECR\n    -  comando\n    - vCPU/memória/GPU\n    - IAM role do container \n    - variáveis de ambiente\n    - volumes/EFS\n    - retryStrategy\n    - timeout",
      "autoResize": false,
      "lineHeight": 1.25
    },
