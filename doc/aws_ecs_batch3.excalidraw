    {
      "id": "k9J0JhZI2vocAq2R9GWwB",
      "type": "text",
      "x": -4193.000690794683,
      "y": 3562.6850301175355,
      "width": 1985.6534830729165,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "baP",
      "roundness": null,
      "seed": 1766749117,
      "version": 1184,
      "versionNonce": 1302486835,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784414837051,
      "link": null,
      "locked": false,
      "text": "O agrupamento lógico onde tasks e services rodam. Um limite de isolamento e organização; você pode misturar Fargate e EC2 no mesmo cluster.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O agrupamento lógico onde tasks e services rodam. Um limite de isolamento e organização; você pode misturar Fargate e EC2 no mesmo cluster.",
      "autoResize": false,
      "lineHeight": 1.25
    },
