      "isDeleted": false,
      "boundElements": [],
      "updated": 1785715119539,
      "link": null,
      "locked": false,
      "text": "A submissão em si (SubmitJob). \n- A unidade de trabalho\n- É um container rodando\n\nPode sobrescrever parâmetros da Job Definition na hora.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A submissão em si (SubmitJob). \n- A unidade de trabalho\n- É um container rodando\n\nPode sobrescrever parâmetros da Job Definition na hora.",
      "autoResize": false,
      "lineHeight": 1.25
    },
