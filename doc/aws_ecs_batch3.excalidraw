      "isDeleted": false,
      "boundElements": [],
      "updated": 1785765185994,
      "link": null,
      "locked": false,
      "text": "import boto3\n\nclient_batch = boto3.client(\"batch\")\n\nresponse = client_batch.submit_job(\n    jobName=\"job-process-20260701\",\n    jobQueue=\"minha-job-queue\",\n    jobDefinition=\"meu-job-definition\",\n    arrayProperties={\n        \"size\": 1000\n    },\n    containerOverrides={\n        \"environment\": [\n            {\n                \"name\": \"MANIFEST_S3_PREFIX\",\n                \"value\": \"s3://wu4-inference/batch-runs/2026/07/01/manifest-{index}.json\",\n            },\n        ]\n    },\n    retryStrategy={\n        \"attempts\": 3\n    },\n)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import boto3\n\nclient_batch = boto3.client(\"batch\")\n\nresponse = client_batch.submit_job(\n    jobName=\"job-process-20260701\",\n    jobQueue=\"minha-job-queue\",\n    jobDefinition=\"meu-job-definition\",\n    arrayProperties={\n        \"size\": 1000\n    },\n    containerOverrides={\n        \"environment\": [\n            {\n                \"name\": \"MANIFEST_S3_PREFIX\",\n                \"value\": \"s3://wu4-inference/batch-runs/2026/07/01/manifest-{index}.json\",\n            },\n        ]\n    },\n    retryStrategy={\n        \"attempts\": 3\n    },\n)",
      "autoResize": true,
      "lineHeight": 1.25
    },
