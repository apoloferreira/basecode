      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import boto3\n\nclient_batch = boto3.client(\"batch\")\n\nresponse = client_batch.submit_job(\n    jobName=\"job-process-20260701\",\n    jobQueue=\"minha-job-queue\",\n    jobDefinition=\"meu-job-definition\",\n    containerOverrides={\n        \"environment\": [\n            {\n                \"name\": \"ID_POLIGONO\",\n                \"value\": \"abcd123\",\n            },\n            {\n                \"name\": \"DATA_IMAGEM\",\n                \"value\": \"2026-07-01 12:30:00\",\n            },\n        ]\n    },\n    retryStrategy={\n        \"attempts\": 3\n    },\n)",
